# Requis pour le geocodage Mapbox (sinon fallback automatique sur OpenStreetMap)
MAPBOX_ACCESS_TOKEN=

# Optionnel : forcer un provider ("mapbox" ou "openstreetmap"), sinon auto selon les tokens dispos
BIZZI_MAPS_PROVIDER=
BIZZI_MAPS_STRICT_PROVIDER=false

# Optionnel : journalisation des recherches dans Supabase (table map_lookup_events)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : personnalisation OpenStreetMap
OPENSTREETMAP_NOMINATIM_URL=
OPENSTREETMAP_ROUTING_URL=
OPENSTREETMAP_USER_AGENT=
